<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wangji.luckystudy"
    android:versionCode="13"
    android:versionName="1.4.4">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- 只用于访问 127.0.0.1 上由应用自己启动的静态文件服务，以及从自己的
         GitHub Pages 更新源下载带 SHA-256 校验的新版 APK，不访问其他远程网络。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：下载完成后交给 Android PackageInstaller；
         系统仍会弹出一次安装确认，普通应用无法跳过。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name=".PhotoFileProvider"
            android:authorities="com.wangji.luckystudy.photos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
